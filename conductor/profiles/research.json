{
  "domain": "research",
  "version": "2.0.0",
  "data_classification": "internal",
  "isolation": {
    "strategy": "folder",
    "base_path": ".worktrees/",
    "pattern": "{track_id}-{role}",
    "access_control": {
      "conductor_access": "read-only-copy",
      "cross_agent_visibility": false
    }
  },
  "agent_archetypes": [],
  "shared_truth": {
    "product": "conductor/product.md",
    "tech_stack": "conductor/tech-stack.md",
    "workflow": "conductor/workflow.md"
  },
  "quality_gates": [
    { "type": "source_verification", "mechanism": "deterministic", "required": true },
    { "type": "recency_check", "mechanism": "deterministic", "required": true }
  ],
  "aggregation": {
    "strategy": "matrix_assembly",
    "reviewer_agent": "research_lead"
  },
  "budget": {
    "max_agents": 6,
    "budget_limit_usd": 4.00,
    "cost_estimation_before_dispatch": true,
    "circuit_breaker_token_limit": 400000
  },
  "phases": [
    {
      "name": "data_gathering",
      "description": "Data collection and source acquisition",
      "agent_roles": ["web_researcher", "data_collector"]
    },
    {
      "name": "synthesis",
      "description": "Analysis, synthesis, and report generation",
      "agent_roles": ["analyst", "report_writer"]
    }
  ],
  "failure_strategy": {
    "strategy": "partial_merge_with_approval",
    "retry_failed": false,
    "max_retry_attempts": 2
  }
}
