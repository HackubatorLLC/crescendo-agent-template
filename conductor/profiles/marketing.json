{
  "domain": "marketing",
  "version": "1.0.0",
  "data_classification": "public",
  "isolation": {
    "strategy": "folder",
    "base_path": ".worktrees/",
    "pattern": "{track_id}-{role}",
    "access_control": {
      "conductor_access": "read-only-copy",
      "cross_agent_visibility": false
    }
  },
  "agent_archetypes": [],
  "shared_truth": {
    "product": "conductor/product.md",
    "tech_stack": "conductor/tech-stack.md",
    "workflow": "conductor/workflow.md"
  },
  "quality_gates": [
    { "type": "brand_consistency", "mechanism": "heuristic", "agent": "brand_reviewer", "required": true }
  ],
  "aggregation": {
    "strategy": "editorial_merge",
    "reviewer_agent": "editor_in_chief"
  },
  "budget": {
    "max_agents": 6,
    "max_retries_per_agent": 2
  }
}
