{
  "domain": "engineering",
  "version": "3.0.0",
  "data_classification": "internal",
  "composition": {
    "extends": null,
    "mixins": []
  },
  "isolation": {
    "strategy": "worktree",
    "base_path": ".worktrees/",
    "pattern": "{track_id}-{role}",
    "access_control": {
      "conductor_access": "read-only-copy",
      "cross_agent_visibility": false
    }
  },
  "agent_archetypes": [],
  "shared_truth": {
    "product": "conductor/product.md",
    "tech_stack": "conductor/tech-stack.md",
    "workflow": "conductor/workflow.md"
  },
  "quality_gates": [
    { "type": "unit_tests", "mechanism": "deterministic", "required": true },
    { "type": "lint", "mechanism": "deterministic", "required": true },
    { "type": "code_review", "mechanism": "heuristic", "agent": "code_reviewer", "required": true }
  ],
  "aggregation": {
    "strategy": "git_merge",
    "reviewer_agent": "coordinator"
  },
  "budget": {
    "max_agents": 8,
    "budget_limit_usd": 5.00,
    "cost_estimation_before_dispatch": true,
    "circuit_breaker_token_limit": 500000
  },
  "phases": [
    {
      "name": "foundation",
      "description": "Foundation and data layer setup",
      "agent_roles": ["data_engineer", "architect"]
    },
    {
      "name": "implementation",
      "description": "Core feature implementation",
      "agent_roles": ["backend_developer", "frontend_developer"]
    },
    {
      "name": "testing_and_review",
      "description": "Testing, code review, and quality assurance",
      "agent_roles": ["tester", "code_reviewer"]
    }
  ],
  "failure_strategy": {
    "strategy": "all_or_nothing",
    "retry_failed": true,
    "max_retry_attempts": 2
  },
  "temporal_constraints": {
    "deadline_aware": false,
    "output_ttl_hours": null,
    "real_time": false
  },
  "iteration_policy": {
    "max_refinement_rounds": 1,
    "feedback_loop": "code_review",
    "auto_iterate_on_gate_failure": true
  },
  "resource_locking": {
    "exclusive_files": true,
    "lock_mechanism": "git_worktree",
    "conflict_resolution": "merge"
  },
  "contradiction_detection": {
    "layers": ["claims"],
    "claims_required": true,
    "blocking_layers": ["claims"]
  },
  "output_contract": {
    "claims_required": true,
    "claims_schema": "entity-attribute-value"
  },
  "model_routing": {
    "strategy": "capability_matched",
    "roles": {
      "coordinator": {
        "capabilities_required": ["planning", "orchestration", "long_context"],
        "preferred": ["gemini-3.1-pro-high"],
        "fallback": ["claude-opus-4.6-thinking", "gemini-3.1-pro-low"],
        "min_tier": "pro"
      },
      "worker": {
        "capabilities_required": ["code_generation", "reasoning"],
        "preferred": ["gemini-3.1-pro-high", "claude-opus-4.6"],
        "fallback": ["gemini-3.1-pro-low", "claude-sonnet-4.6"],
        "min_tier": "pro"
      },
      "quality_reviewer": {
        "capabilities_required": ["reasoning", "analysis"],
        "preferred": ["claude-opus-4.6-thinking"],
        "fallback": ["gemini-3.1-pro-high"],
        "min_tier": "pro"
      },
      "bookkeeping": {
        "capabilities_required": ["file_reading"],
        "preferred": ["gemini-3.1-flash"],
        "fallback": ["claude-haiku-4"],
        "min_tier": "flash"
      }
    },
    "session_awareness": {
      "track_usage_per_model": true,
      "auto_fallback_on_limit": true
    }
  }
}
