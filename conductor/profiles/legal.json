{
  "domain": "legal",
  "version": "3.0.0",
  "data_classification": "confidential",
  "composition": {
    "extends": null,
    "mixins": []
  },
  "isolation": {
    "strategy": "folder",
    "base_path": ".worktrees/",
    "pattern": "{track_id}-{role}",
    "access_control": {
      "conductor_access": "read-only-copy",
      "cross_agent_visibility": false
    }
  },
  "agent_archetypes": [],
  "shared_truth": {
    "product": "conductor/product.md",
    "tech_stack": "conductor/tech-stack.md",
    "workflow": "conductor/workflow.md"
  },
  "quality_gates": [
    { "type": "citation_audit", "mechanism": "deterministic", "required": true },
    {
      "type": "compliance_review",
      "mechanism": "heuristic",
      "agents": ["compliance_officer", "senior_counsel"],
      "required": true
    }
  ],
  "aggregation": {
    "strategy": "document_assembly",
    "reviewer_agent": "general_counsel"
  },
  "budget": {
    "max_agents": 4,
    "budget_limit_usd": 8.00,
    "cost_estimation_before_dispatch": true,
    "circuit_breaker_token_limit": 600000
  },
  "phases": [
    {
      "name": "classification",
      "description": "Issue classification and jurisdiction determination",
      "agent_roles": ["classifier", "intake_analyst"]
    },
    {
      "name": "parallel_analysis",
      "description": "Concurrent legal analysis across specializations",
      "agent_roles": ["contract_analyst", "regulatory_analyst", "case_researcher"]
    },
    {
      "name": "compliance_review",
      "description": "Final compliance review and sign-off",
      "agent_roles": ["compliance_officer", "senior_counsel"]
    }
  ],
  "failure_strategy": {
    "strategy": "all_or_nothing",
    "retry_failed": true,
    "max_retry_attempts": 2
  },
  "temporal_constraints": {
    "deadline_aware": true,
    "output_ttl_hours": 2160,
    "real_time": false
  },
  "iteration_policy": {
    "max_refinement_rounds": 2,
    "feedback_loop": "compliance_review",
    "auto_iterate_on_gate_failure": true
  },
  "resource_locking": {
    "exclusive_files": true,
    "lock_mechanism": "folder_isolation",
    "conflict_resolution": "human_arbitration"
  },
  "contradiction_detection": {
    "layers": ["claims", "similarity", "adversarial"],
    "claims_required": true,
    "similarity_model_tier": "flash",
    "adversarial_model_tier": "pro",
    "blocking_layers": ["claims", "similarity"]
  },
  "output_contract": {
    "claims_required": true,
    "claims_schema": "entity-attribute-value"
  },
  "model_routing": {
    "strategy": "capability_matched",
    "roles": {
      "coordinator": {
        "capabilities_required": ["planning", "orchestration", "long_context"],
        "preferred": ["claude-opus-4.6-thinking"],
        "fallback": ["gemini-3.1-pro-high"],
        "min_tier": "pro"
      },
      "worker": {
        "capabilities_required": ["reasoning", "legal_analysis", "long_context"],
        "preferred": ["claude-opus-4.6-thinking"],
        "fallback": ["gemini-3.1-pro-high", "claude-opus-4.6"],
        "min_tier": "pro"
      },
      "quality_reviewer": {
        "capabilities_required": ["reasoning", "compliance", "analysis"],
        "preferred": ["claude-opus-4.6-thinking"],
        "fallback": ["gemini-3.1-pro-high"],
        "min_tier": "pro"
      },
      "bookkeeping": {
        "capabilities_required": ["file_reading"],
        "preferred": ["gemini-3.1-flash"],
        "fallback": ["claude-haiku-4"],
        "min_tier": "flash"
      }
    },
    "session_awareness": {
      "track_usage_per_model": true,
      "auto_fallback_on_limit": true
    }
  }
}
