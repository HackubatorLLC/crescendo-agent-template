{
  "domain": "localization",
  "version": "3.0.0",
  "data_classification": "internal",
  "composition": {
    "extends": null,
    "mixins": []
  },
  "isolation": {
    "strategy": "folder",
    "base_path": ".worktrees/",
    "pattern": "{track_id}-{role}",
    "access_control": {
      "conductor_access": "read-only-copy",
      "cross_agent_visibility": true
    }
  },
  "agent_archetypes": [],
  "shared_truth": {
    "product": "conductor/product.md",
    "tech_stack": "conductor/tech-stack.md",
    "workflow": "conductor/workflow.md"
  },
  "quality_gates": [
    { "type": "string_coverage", "mechanism": "deterministic", "required": true },
    { "type": "cultural_review", "mechanism": "heuristic", "agent": "cultural_reviewer", "required": true }
  ],
  "aggregation": {
    "strategy": "matrix_assembly",
    "reviewer_agent": "localization_lead"
  },
  "budget": {
    "max_agents": 10,
    "budget_limit_usd": 4.00,
    "cost_estimation_before_dispatch": true,
    "circuit_breaker_token_limit": 400000
  },
  "phases": [
    {
      "name": "extraction",
      "description": "Extract translatable strings and context from source",
      "agent_roles": ["string_extractor"]
    },
    {
      "name": "translation",
      "description": "Parallel translation across target locales",
      "agent_roles": ["translator_es", "translator_fr", "translator_de", "translator_ja", "translator_ar"]
    },
    {
      "name": "cultural_qa",
      "description": "Cultural appropriateness and consistency review",
      "agent_roles": ["cultural_reviewer", "localization_lead"]
    }
  ],
  "failure_strategy": {
    "strategy": "partial_merge_with_approval",
    "retry_failed": true,
    "max_retry_attempts": 2
  },
  "temporal_constraints": {
    "deadline_aware": true,
    "output_ttl_hours": 2160,
    "real_time": false
  },
  "iteration_policy": {
    "max_refinement_rounds": 2,
    "feedback_loop": "cultural_review",
    "auto_iterate_on_gate_failure": true
  },
  "resource_locking": {
    "exclusive_files": false,
    "lock_mechanism": "folder_isolation",
    "conflict_resolution": "merge"
  },
  "contradiction_detection": {
    "layers": ["claims", "similarity"],
    "claims_required": true,
    "similarity_model_tier": "flash",
    "blocking_layers": ["claims"]
  },
  "output_contract": {
    "claims_required": true,
    "claims_schema": "entity-attribute-value"
  },
  "model_routing": {
    "strategy": "capability_matched",
    "roles": {
      "coordinator": {
        "capabilities_required": ["planning", "orchestration", "multilingual"],
        "preferred": ["gemini-3.1-pro-high"],
        "fallback": ["claude-opus-4.6", "gemini-3.1-pro-low"],
        "min_tier": "pro"
      },
      "worker": {
        "capabilities_required": ["translation", "multilingual", "cultural_awareness"],
        "preferred": ["gemini-3.1-pro-high"],
        "fallback": ["claude-opus-4.6", "gemini-3.1-pro-low"],
        "min_tier": "standard"
      },
      "quality_reviewer": {
        "capabilities_required": ["multilingual", "cultural_awareness", "analysis"],
        "preferred": ["claude-opus-4.6"],
        "fallback": ["gemini-3.1-pro-high"],
        "min_tier": "pro"
      },
      "bookkeeping": {
        "capabilities_required": ["file_reading"],
        "preferred": ["gemini-3.1-flash"],
        "fallback": ["claude-haiku-4"],
        "min_tier": "flash"
      }
    },
    "session_awareness": {
      "track_usage_per_model": true,
      "auto_fallback_on_limit": true
    }
  }
}
